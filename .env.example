# Get a bot token from @BotFather, then add the bot as a channel admin.
TELEGRAM_BOT_TOKEN=replace-me
# Public channel username (@example) or private channel numeric ID (-100...).
TELEGRAM_CHANNEL_ID=@your_channel
RSS_URL=https://godotengine.org/rss.xml
POLL_INTERVAL_SECONDS=900
STATE_DB_PATH=./data/seen.sqlite3
# true sends all currently visible feed items the first time the bot runs.
POST_EXISTING_ON_START=false
